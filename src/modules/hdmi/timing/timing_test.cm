//! platform: sv
module timing_test;

// ============================================================
// HDMIビデオタイミング生成の検証ラッパー
// ============================================================
// timing.cm を取り込み、hsync/vsync/de をポートへ写して
// VGA 640x480@60Hz の水平タイミングを検証する
// ============================================================

#[input] posedge clk;

// timing.cm は pixel_clk を参照するため clk から供給する
assign bool pixel_clk = clk;

import ./timing;

// 検証用出力（1クロック遅れの写し）
struct timing_test_io {
    #[output] bool hsync_o = true;
    #[output] bool vsync_o = true;
    #[output] bool de_o = false;
};

timing_test_io io;

async void mirror(posedge pixel_clk) {
    io.hsync_o = hsync_reg;
    io.vsync_o = vsync_reg;
    io.de_o = de_reg;
}

import std::debug::assert;

// テストベンチ: 水平タイミング（アクティブ→FP→SYNC→BP）を検証
#[test]
void tb() {
    step(4);
    assert(io.de_o, "active region: de on");
    assert(io.hsync_o, "active region: hsync high");
    assert(io.vsync_o, "first line: vsync high");

    // hc≈665（FP終了後のSYNC区間 656..751 内）まで進める
    step(662);
    assert(!io.de_o, "blanking: de off");
    assert(!io.hsync_o, "sync region: hsync low");

    // SYNC区間を抜けてBPへ（hc≈770）
    step(105);
    assert(io.hsync_o, "back porch: hsync high again");
    assert(io.vsync_o, "still first line: vsync high");

    // 垂直: VSYNCパルス区間（vc=490..491、V_ACTIVE+V_FP後）まで進める（現在位置771 → 490行目のhc≈100）
    step(490 * 800 + 100 - 771);
    assert(!io.vsync_o, "vsync pulse region: vsync low");
    assert(!io.de_o, "vertical blanking: de off");

    // VSYNCパルスを抜ける（vc=492、バックポーチ）
    step(2 * 800);
    assert(io.vsync_o, "vertical back porch: vsync high again");
    assert(!io.de_o, "vertical back porch: de still off");

    // フレーム境界を跨いで次フレームのアクティブ領域へ（vc=0, hc≈100）
    step(33 * 800);
    assert(io.de_o, "next frame active region: de on");
    assert(io.vsync_o, "next frame first line: vsync high");
}
