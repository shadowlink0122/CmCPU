//! platform: sv
module encoder_test;

// ============================================================
// TMDSエンコーダの検証ラッパー
// ============================================================
// timing + encoder を取り込み、画素値を入力ポートから供給して
// ブランキング期間のコントロールトークンとデータ符号を検証する
// ============================================================

#[input] posedge clk;
assign bool pixel_clk = clk;

import ../constants/hdmi_constants;
import ../timing/timing;
import ./encoder;

#[input] uint r_in;
#[input] uint g_in;
#[input] uint b_in;

#[output] uint tmds_r_o = 0;
#[output] uint tmds_g_o = 0;
#[output] uint tmds_b_o = 0;

async void feed(posedge pixel_clk) {
    r_out = r_in as int;
    g_out = g_in as int;
    b_out = b_in as int;
    tmds_r_o = tmds_r as uint;
    tmds_g_o = tmds_g as uint;
    tmds_b_o = tmds_b as uint;
}

import std::debug::assert;

// テストベンチ: コントロールトークン（両sync非アクティブ/hsyncパルス中）と
// アクティブ期間のデータ符号がトークンと異なることを検証
#[test]
void tb() {
    r_in = 128;
    g_in = 128;
    b_in = 128;

    // アクティブ領域: データ符号はコントロールトークンにならない（TMDSの性質）
    step(10);
    assert(tmds_r_o != CTRL_00, "active: R is data code (not CTRL_00)");
    assert(tmds_b_o != CTRL_11, "active: B is data code (not CTRL_11)");

    // ブランキング（sync非アクティブ、hc≈648）: R/G=CTRL_00, B=CTRL_11
    step(638);
    assert(tmds_r_o == CTRL_00, "blank: R ctrl token CTRL_00");
    assert(tmds_g_o == CTRL_00, "blank: G ctrl token CTRL_00");
    assert(tmds_b_o == CTRL_11, "blank: B ctrl {vs=1,hs=1} CTRL_11");

    // HSYNCパルス中（hc≈700）: B=CTRL_01
    step(52);
    assert(tmds_b_o == CTRL_10, "hsync pulse: B ctrl {vs=1,hs=0} CTRL_10");
}
