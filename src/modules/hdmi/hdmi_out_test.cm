//! platform: sv
module hdmi_out_test;

// ============================================================
// 汎用HDMI出力モジュール（hdmi_out）の検証ラッパー
// ============================================================
// 固定色（グレー: R=G=B=128）を供給し、タイミング→TMDSエンコードの
// パイプライン全体を検証する。3チャネルへ同一値・同一履歴を与えるため、
// アクティブ領域では3チャネルのTMDS符号が常に一致する
// ============================================================

#[input] posedge clk;
assign bool pixel_clk = clk;

import ./hdmi_out;

// 固定色の供給（機能側プログラムの最小形）
async void drive(posedge pixel_clk) {
    r_out = 128;
    g_out = 128;
    b_out = 128;
}

// 検証用出力: TMDS符号の写し
#[output] uint tmds_r_o = 0;
#[output] uint tmds_g_o = 0;
#[output] uint tmds_b_o = 0;

async void mirror(posedge pixel_clk) {
    tmds_r_o = tmds_r as uint;
    tmds_g_o = tmds_g as uint;
    tmds_b_o = tmds_b as uint;
}

import std::debug::assert;

#[test]
void tb() {
    // アクティブ領域: 3チャネルとも同一のデータ符号（コントロールトークンではない）
    step(10);
    assert(tmds_r_o != 852, "active: R is data code");
    assert(tmds_r_o == tmds_g_o, "active: R and G codes match (same input history)");
    assert(tmds_r_o == tmds_b_o, "active: R and B codes match (same input history)");

    // 水平ブランキング: コントロールトークン
    step(638);
    assert(tmds_r_o == 852, "blank: R ctrl token CTRL_00");
    assert(tmds_g_o == 852, "blank: G ctrl token CTRL_00");
    assert(tmds_b_o == 683, "blank: B ctrl {vs=1,hs=1}");

    // HSYNCパルス中: Bチャネルのみhsが反映される
    step(52);
    assert(tmds_b_o == 340, "hsync: B ctrl {vs=1,hs=0}");
    assert(tmds_r_o == 852, "hsync: R stays CTRL_00");
}
