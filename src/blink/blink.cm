//! platform: sv

// Tang 138K Console Lチカ回路
// Gowin内蔵オシレータ(52.5MHz) → 0.5秒カウンタ → LED出力トグル
//
// ハードウェア: Sipeed Tang 138K Console (GW5AST-LV138PG484A)
// クロック: Gowin内蔵OSC (210MHz / FREQ_DIV = 52.5MHz)
// LED: CFG LED READY (U12), DONE (G11)

// 定数定義
const uint CLK_FREQ = 210000000 / 4;  // 内蔵OSC 210MHz / FREQ_DIV(4)

#ifdef TEST
    // シミュレーション: クロックを外部注入し、トグル周期を短縮
    #[input] posedge clk;
    const uint HALF_SEC_COUNT = 1;
#else
    const uint HALF_SEC_COUNT = CLK_FREQ / 2 - 1;  // 0.5秒分のカウント値

    // Gowin 内蔵オシレータの外部モジュール定義
    extern struct OSC {
        #[sv::param] int FREQ_DIV = 4;
        #[output] bool OSCOUT = clk;
    }
#end

// 出力ポート: CFG LED
#[output] bool led_ready = false;
#[output] bool led_done  = false;

// 内部信号
uint counter = 0;

#ifndef TEST
    bool clk = false;

    // Gowin 内蔵オシレータのインスタンス化
    OSC osc_inst;
#end

// メインクロック処理（posedge clk で駆動）
void blink(posedge clk) {
    if (counter == HALF_SEC_COUNT) {
        counter = 0;
        led_ready = !led_ready;
        led_done = !led_done;
    } else {
        counter = counter + 1;
    }
}

import std::debug::assert;

// テストベンチ: HALF_SEC_COUNT=1 のため2クロックごとにLEDがトグルする
#[test]
void tb() {
    step(2);
    assert(led_ready, "led toggles on after 2 clocks");
    assert(led_done, "led_done follows led_ready");
    step(2);
    assert(!led_ready, "led toggles off after 2 more clocks");
    step(4);
    assert(!led_ready, "full period returns to off");
}
