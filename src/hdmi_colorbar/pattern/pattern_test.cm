//! platform: sv
module pattern_test;

// ============================================================
// カラーバーパターン生成の検証ラッパー
// ============================================================

#[input] posedge clk;
assign bool pixel_clk = clk;

import ../../modules/hdmi/timing/timing;
import ./pattern;

struct PatternTestIo {
    #[output] uint r_o = 0;
    #[output] uint g_o = 0;
    #[output] uint b_o = 0;
};

PatternTestIo io;

async void mirror(posedge pixel_clk) {
    io.r_o = r_out as uint;
    io.g_o = g_out as uint;
    io.b_o = b_out as uint;
}

import std::debug::assert;

// テストベンチ: 8色カラーバーの境界を検証（バー幅80px、遅延±3安全位置で採取）
#[test]
void tb() {
    step(40);  // バー0中央
    assert(io.r_o == 255, "bar0 white: r");
    assert(io.g_o == 255, "bar0 white: g");
    assert(io.b_o == 255, "bar0 white: b");

    step(80);  // バー1中央（hc≈120）: 黄
    assert(io.r_o == 255, "bar1 yellow: r");
    assert(io.b_o == 0, "bar1 yellow: b=0");

    step(80);  // バー2中央（hc≈200）: シアン
    assert(io.r_o == 0, "bar2 cyan: r=0");
    assert(io.g_o == 255, "bar2 cyan: g");

    step(400);  // バー7中央（hc≈600）: 黒
    assert(io.r_o == 0, "bar7 black: r");
    assert(io.g_o == 0, "bar7 black: g");
    assert(io.b_o == 0, "bar7 black: b");
}
