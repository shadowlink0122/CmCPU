module demo_program;

import ../core/decoder;

// ============================================================
// デモプログラム: C言語風コードを手動コンパイルしたもの
// ============================================================
// 対応するC風コード:
//   int twice(int x) { return x + x; }
//   int main() {
//       int sum = 0;
//       for (int i = 1; i != 11; i = i + 1) {
//           sum = sum + i;                  // sum = 1+2+...+10 = 55
//       }
//       sum = twice(sum);                   // sum = 110
//       *(int*)16 = sum;                    // RAMへストア
//       int check = *(int*)16;              // RAMからロード
//       *(volatile int*)0xFF = check;       // MMIO: 結果出力 (110)
//       while (1) {}                        // HALT
//   }
//
// レジスタ割り当て: r1=i / r2=sum / r3=ループ上限(11) / r4=check / r5=MMIOアドレス / r7=リンク
// ============================================================

export uint[16] prog_rom = [
    (OP_LDI << 12) | (1 << 9) | 1,                    //  0: LDI  r1, 1        ; i = 1
    (OP_LDI << 12) | (2 << 9) | 0,                    //  1: LDI  r2, 0        ; sum = 0
    (OP_LDI << 12) | (3 << 9) | 11,                   //  2: LDI  r3, 11       ; ループ上限
    (OP_ADD << 12) | (2 << 9) | (2 << 6) | (1 << 3),  //  3: ADD  r2, r2, r1   ; sum += i  <- ループ先頭
    (OP_ADDI << 12) | (1 << 9) | (1 << 6) | 1,        //  4: ADDI r1, r1, 1    ; i++
    (OP_BNE << 12) | (1 << 9) | (3 << 6) | 61,        //  5: BNE  r1, r3, -3   ; i != 11 なら 3 へ (61 = -3 & 63)
    (OP_JAL << 12) | (7 << 9) | 12,                   //  6: JAL  r7, 12       ; twice(sum) を呼ぶ
    (OP_ST << 12) | (2 << 9) | (0 << 6) | 16,         //  7: ST   r2, [r0+16]  ; dram[16] = sum
    (OP_LD << 12) | (4 << 9) | (0 << 6) | 16,         //  8: LD   r4, [r0+16]  ; check = dram[16]
    (OP_LDI << 12) | (5 << 9) | 255,                  //  9: LDI  r5, 255      ; MMIOアドレス
    (OP_ST << 12) | (4 << 9) | (5 << 6) | 0,          // 10: ST   r4, [r5+0]   ; result_out = check
    (OP_HALT << 12),                                  // 11: HALT
    (OP_ADD << 12) | (2 << 9) | (2 << 6) | (2 << 3),  // 12: ADD  r2, r2, r2   ; twice: x + x
    (OP_JR << 12) | (7 << 6),                         // 13: JR   r7           ; return
    0,                                                // 14: NOP (パディング)
    0                                                 // 15: NOP (パディング)
];
