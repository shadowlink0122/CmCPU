module demo_program;

import ../core/decoder;

// ============================================================
// デモプログラム: C言語風コードを手動コンパイルしたもの
// ============================================================
// 対応するC風コード:
//   int twice(int x) { return x + x; }
//   int main() {
//       int sum = 0;
//       for (int i = 1; i != 11; i = i + 1) {
//           sum = sum + i;                  // sum = 1+2+...+10 = 55
//       }
//       sum = twice(sum);                   // sum = 110
//       *(int*)16 = sum;                    // RAMへストア
//       int check = *(int*)16;              // RAMからロード
//       *(volatile int*)0xFF = check;       // MMIO: 結果出力 (110)
//       while (1) {}                        // HALT
//   }
//
// レジスタ割り当て: r1=i / r2=sum / r3=ループ上限(11) / r4=check / r5=MMIOアドレス / r7=リンク
//
// アセンブリリスト (プログラムROMの中身):
//    0: LDI  r1, 1        ; i = 1
//    1: LDI  r2, 0        ; sum = 0
//    2: LDI  r3, 11       ; ループ上限
//    3: ADD  r2, r2, r1   ; sum += i  <- ループ先頭
//    4: ADDI r1, r1, 1    ; i++
//    5: BNE  r1, r3, -3   ; i != 11 なら 3 へ (-3 & 63 = 61)
//    6: JAL  r7, 12       ; twice(sum) を呼ぶ
//    7: ST   r2, [r0+16]  ; dram[16] = sum
//    8: LD   r4, [r0+16]  ; check = dram[16]
//    9: LDI  r5, 255      ; MMIOアドレス
//   10: ST   r4, [r5+0]   ; result_out = check
//   11: HALT
//   12: ADD  r2, r2, r2   ; twice: x + x
//   13: JR   r7           ; return
//   14: NOP (パディング)
//   15: NOP (パディング)
//
// 注意: exportする配列の初期化子は1行で書く（プリプロセッサのexport再宣言が複数行初期化子に未対応）
// ============================================================

export uint[16] prog_rom = [(OP_LDI << 12) | (1 << 9) | 1, (OP_LDI << 12) | (2 << 9) | 0, (OP_LDI << 12) | (3 << 9) | 11, (OP_ADD << 12) | (2 << 9) | (2 << 6) | (1 << 3), (OP_ADDI << 12) | (1 << 9) | (1 << 6) | 1, (OP_BNE << 12) | (1 << 9) | (3 << 6) | 61, (OP_JAL << 12) | (7 << 9) | 12, (OP_ST << 12) | (2 << 9) | (0 << 6) | 16, (OP_LD << 12) | (4 << 9) | (0 << 6) | 16, (OP_LDI << 12) | (5 << 9) | 255, (OP_ST << 12) | (4 << 9) | (5 << 6) | 0, (OP_HALT << 12), (OP_ADD << 12) | (2 << 9) | (2 << 6) | (2 << 3), (OP_JR << 12) | (7 << 6), 0, 0];
