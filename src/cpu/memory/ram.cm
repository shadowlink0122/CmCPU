//! platform: sv

module ram;

// ============================================================
// データRAMとメモリマップドI/O
// ============================================================
// アドレス空間 (LD/ST命令の実効アドレス、下位8bitを使用):
//   0x00〜0xFE: データRAM
//   0xFF:       結果出力ポート (書き込むと下位8bitがresult_outへ出る)
// ============================================================

export const uint RAM_SIZE = 256;

// 結果出力ポートのアドレス。C言語風に書くと *(volatile int*)0xFF = x; に相当する
export const uint MMIO_RESULT_ADDR = 255;

// データRAM (合成時はRAM推論される。書き込みはコアの実行プロセスが行う)
export uint[256] dram;
