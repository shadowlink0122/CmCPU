//! platform: sv

module alu;

import ./adder;

// ============================================================
// ALU: 算術論理演算ユニット
// ============================================================
// 加減算は全加算器ベースのadd32で行う（減算は2の補数: a + ~b + 1）
// opはISAのオペコードと同じ値を使う（decoder.cmのOP_*を参照）
// ============================================================

// シフト方向 (SHIFT命令のfunctフィールド)
export const uint FN_SHL = 0;
export const uint FN_SHR = 1;

export uint alu_exec(uint op, uint funct, uint a, uint b) {
    if (op == 1) {
        return add32(a, b, 0);          // ADD
    } else if (op == 2) {
        return add32(a, ~b, 1);         // SUB (2の補数)
    } else if (op == 3) {
        return a & b;                   // AND
    } else if (op == 4) {
        return a | b;                   // OR
    } else if (op == 5) {
        return a ^ b;                   // XOR
    } else if (op == 6) {
        if (funct == FN_SHL) {
            return a << 1;              // SHL (1bit論理左シフト)
        }
        return a >> 1;                  // SHR (1bit論理右シフト)
    }
    return 0;
}
