//! platform: sv

module register_file;

// ============================================================
// レジスタファイル: 汎用レジスタ r0〜r7
// ============================================================
// r0は常に0（RISC慣習）。書き込みはコアの実行プロセスが行い、読み出しはrf_read経由でr0の固定0を保証する
//
// 呼び出し規約（Cライク言語のコンパイル対象とする際の推奨）:
//   r0 = 定数0 / r1〜r3 = 引数・戻り値 / r4〜r5 = 一時
//   r6 = スタックポインタ / r7 = リンクレジスタ（JALの戻り先）
// ============================================================

export uint[8] regs = [0, 0, 0, 0, 0, 0, 0, 0];

// レジスタ読み出し (r0は常に0を返す)
export uint rf_read(uint idx) {
    if (idx == 0) {
        return 0;
    }
    return regs[idx & 7];
}
