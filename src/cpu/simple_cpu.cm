//! platform: sv

// ============================================================
// SimpleCPU: 8レジスタ・16bit命令のロード/ストア型CPUサンプル
// ============================================================
// ターゲット: Sipeed Tang Console 138K (GW5AST-LV138PG484A)
// クロック: Gowin内蔵OSC (210MHz / FREQ_DIV = 52.5MHz)
//
// C言語風の簡単なプログラミング言語のコンパイル対象にできる
// 基本命令セット（算術論理・ロード/ストア・分岐・関数呼び出し）を持つ。
// 命令セットの詳細は core/decoder.cm と docs/cpu_isa.md を参照。
//
// 構成 (基本回路をファイル分割):
//   core/adder.cm         全加算器・リップルキャリー加算器
//   core/alu.cm           ALU (加減算は全加算器ベース)
//   core/decoder.cm       命令デコーダとオペコード定義
//   core/register_file.cm レジスタファイル (r0固定0)
//   core/core.cm          フェッチ・デコード・実行コア
//   memory/ram.cm         データRAMとMMIO出力
//   program/demo_program.cm デモプログラム (総和×2をMMIOへ出力)
// ============================================================

#ifdef TEST
    // シミュレーション: クロックを外部注入
    #[input] posedge clk;
#else
    // Gowin 内蔵オシレータの外部モジュール定義
    extern struct OSC {
        #[sv::param] int FREQ_DIV = 4;
        #[output] bool OSCOUT = clk;
    }
#end

import ./core/core;

// 出力ポート: 計算結果（下位8bit）と停止表示
#[output] assign utiny result_out = (result_reg & 255) as utiny;
#[output] assign bool halt_led = halted;

#ifndef TEST
    bool clk = false;
    OSC osc_inst;
#end

import std::debug::assert;

// テストベンチ: デモプログラム(総和1..10を2倍してMMIO出力)の実行結果を検証
// 実行サイクル数: 初期化3 + ループ3命令×10周 + 呼び出し3 + ST/LD/出力5 + HALT1 = 42
#[test]
void tb() {
    step(20);
    assert(!halt_led, "still running mid-program");
    step(40);
    assert(halt_led, "program halted");
    assert(halted, "halted register readable via hierarchy");
    assert(result_out == 110, "twice(sum(1..10)) == 110");
    // 停止後は状態が変化しない
    step(10);
    assert(result_out == 110, "result stable after halt");
}
