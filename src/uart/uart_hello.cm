//! platform: sv

// ============================================================
// UART TX "Hello, FPGA!" 送信回路
// ============================================================
// ターゲット: Tang Console 138K (GW5AST-LV138PG484A)
// クロック: Gowin 内蔵 OSC 52.5MHz
// ボーレート: 115200 bps, 8N1
// ============================================================

// 定数定義
const uint CLK_FREQ = 210000000 / 4;  // 内蔵OSC 210MHz / FREQ_DIV(4)
const uint BAUD_RATE = 115200;
const uint MSG_LEN = 14;         // "Hello, FPGA!\r\n"

#ifdef TEST
    // シミュレーション: クロック外部注入・タイミング短縮
    #[input] posedge clk;
    const uint CLKS_PER_BIT = 2;
    const uint STARTUP_DELAY = 2;
#else
    const uint CLKS_PER_BIT = (CLK_FREQ + BAUD_RATE / 2) / BAUD_RATE;  // 四捨五入
    const uint STARTUP_DELAY = CLK_FREQ / 10;  // 起動後0.1秒待機

    // Gowin 内蔵オシレータ
    extern struct OSC {
        #[sv::param] int FREQ_DIV = 4;
        #[output] bool OSCOUT = clk;
    }
#end

// 出力ポート（IOインスタンス）
struct uart_hello_io {
    #[output] bool uart_tx = true;     // UART TX (アイドル = HIGH)
    #[output] bool led_ready = false;  // 送信中 LED
    #[output] bool led_done = false;   // 送信完了 LED
};

uart_hello_io io;

// 内部信号
#ifndef TEST
    bool clk = false;
    OSC osc_inst;
#end

// ステートマシン変数
uint phase = 0;
uint clk_cnt = 0;
uint bit_idx = 0;
uint tx_data = 0;
uint tx_bit = 0;
uint msg_idx = 0;
uint delay_cnt = 0;

// メインプロセス: 全ロジックを1つの always_ff で駆動
void process(posedge clk) {
    if (phase == 0) {
        // 起動待機
        io.uart_tx = true;
        delay_cnt = delay_cnt + 1;
        if (delay_cnt == STARTUP_DELAY) {
            phase = 1;
            io.led_ready = true;
        }
    }
    if (phase == 1) {
        // LOAD: メッセージ ROM から tx_data にロード
        io.uart_tx = true;
        if (msg_idx == 0) { tx_data = 'H' as utiny; }
        if (msg_idx == 1) { tx_data = 'e' as utiny; }
        if (msg_idx == 2) { tx_data = 'l' as utiny; }
        if (msg_idx == 3) { tx_data = 'l' as utiny; }
        if (msg_idx == 4) { tx_data = 'o' as utiny; }
        if (msg_idx == 5) { tx_data = ',' as utiny; }
        if (msg_idx == 6) { tx_data = ' ' as utiny; }
        if (msg_idx == 7) { tx_data = 'F' as utiny; }
        if (msg_idx == 8) { tx_data = 'P' as utiny; }
        if (msg_idx == 9) { tx_data = 'G' as utiny; }
        if (msg_idx == 10) { tx_data = 'A' as utiny; }
        if (msg_idx == 11) { tx_data = '!' as utiny; }
        if (msg_idx == 12) { tx_data = '\r' as utiny; }
        if (msg_idx == 13) { tx_data = '\n' as utiny; }
        phase = 2;
        clk_cnt = 0;
    }
    if (phase == 2) {
        // START ビット
        io.uart_tx = false;
        if (clk_cnt == CLKS_PER_BIT - 1) {
            clk_cnt = 0;
            phase = 3;
            bit_idx = 0;
        } else {
            clk_cnt = clk_cnt + 1;
        }
    }
    if (phase == 3) {
        // DATA ビット: マスク & 除算でビット抽出
        if (bit_idx == 0) { tx_bit = tx_data & 1; }
        if (bit_idx == 1) { tx_bit = (tx_data & 2) / 2; }
        if (bit_idx == 2) { tx_bit = (tx_data & 4) / 4; }
        if (bit_idx == 3) { tx_bit = (tx_data & 8) / 8; }
        if (bit_idx == 4) { tx_bit = (tx_data & 16) / 16; }
        if (bit_idx == 5) { tx_bit = (tx_data & 32) / 32; }
        if (bit_idx == 6) { tx_bit = (tx_data & 64) / 64; }
        if (bit_idx == 7) { tx_bit = (tx_data & 128) / 128; }

        if (tx_bit == 1) { io.uart_tx = true; } else { io.uart_tx = false; }

        if (clk_cnt == CLKS_PER_BIT - 1) {
            clk_cnt = 0;
            if (bit_idx == 7) {
                phase = 4;
            } else {
                bit_idx = bit_idx + 1;
            }
        } else {
            clk_cnt = clk_cnt + 1;
        }
    }
    if (phase == 4) {
        // STOP ビット
        io.uart_tx = true;
        if (clk_cnt == CLKS_PER_BIT - 1) {
            clk_cnt = 0;
            msg_idx = msg_idx + 1;
            if (msg_idx == MSG_LEN) {
                phase = 5;
                io.led_done = true;
                io.led_ready = false;
            } else {
                phase = 1;
            }
        } else {
            clk_cnt = clk_cnt + 1;
        }
    }
    if (phase == 5) {
        // 完了: アイドル
        io.uart_tx = true;
    }
}

import std::debug::assert;

// テストベンチ: 起動待機→スタートビット→全14バイト送信完了を検証
#[test]
void tb() {
    assert(io.uart_tx, "idle high at reset");
    // 起動待機はNBA意味論で3clk（delay_cnt比較は旧値を読む）
    // + LOAD1clk 後にSTARTビット（Low）が2clk続く
    step(5);
    assert(!io.uart_tx, "start bit is low");
    assert(io.led_ready, "sending: io.led_ready on");
    // 1バイト = (start+8data+stop) * 2clk = 20clk、14バイト+ロード分を待つ
    step(320);
    assert(io.uart_tx, "idle high after message");
    assert(io.led_done, "io.led_done on after full message");
    assert(!io.led_ready, "io.led_ready off after completion");
}
