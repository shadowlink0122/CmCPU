//! platform: sv
module animation_ctrl_test;

// ============================================================
// アニメーション制御の検証ラッパー
// ============================================================
// タイトル行描画の境界を検証する: 43文字ちょうどで停止し、
// 直後のセルへ範囲外文字が書き込まれないこと
// (回帰: タイトル末尾に TITLE[43] 由来のゴミ文字 'a' が表示されたバグ)
// ============================================================

#[input] posedge clk;
assign bool pixel_clk = clk;

import ./text_renderer;
import ./animation_ctrl;

// タイトル行はセル(row=8, col=18)起点 → 先頭アドレス 8*80+18 = 658、最終文字 700、直後 701
#[output] uint title_first_o = 0;
#[output] uint title_last_o = 0;
#[output] uint title_after_o = 0;

// 描画フェーズ (anim_ready) 中にタイトル行領域 (アドレス < 1280) へ書かれた最大アドレス。
// 範囲外描画のデータは 'x' になり値比較のassertでは検出できない (x楽観性) ため、アドレスで検査する
#[output] uint title_max_waddr_o = 0;

async void probe(posedge pixel_clk) {
    title_first_o = text_buf[658] as uint;
    title_last_o = text_buf[700] as uint;
    title_after_o = text_buf[701] as uint;

    if (anim_ready && text_we) {
        uint a = text_addr as uint;
        if (a < 1280 && a > title_max_waddr_o) {
            title_max_waddr_o = a;
        }
    }
}

import std::debug::assert;

// 起動待機 (STARTUP_FRAMES×FRAME_CLOCKS = 200clk) + 画面クリア (4800clk) + タイトル43文字 + 余裕
#[test]
void tb() {
    step(5200);
    assert(title_first_o == 61, "title first char is '='");
    assert(title_last_o == 61, "title last char is '='");
    assert(title_after_o == 32, "cell after title stays blank");
    assert(title_max_waddr_o == 700, "title writes stop at addr 700 (43 chars)");
}
