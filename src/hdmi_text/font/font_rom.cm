// このファイルは generate_font.py により自動生成されました。手動で編集しないでください。
// フォントデータ本体は font_rom.hex（$readmemhで読み込み）。
module font_rom;

export const uint FONT_SIZE = 8;
export const uint LOG2_FONT_SIZE = 3;
export const uint TEXT_COLS = 80;
export const uint TEXT_ROWS = 60;
export const uint TEXT_BUF_SIZE = 4800;
export const uint MSG_LEN = 96;

const uint FONT_BASE = 32;
const uint FONT_ENTRIES = 2112;

// フォントROM（BRAM推論 + font_rom.hex から初期化）
#[sv::bram]
#[sv::memfile("font_rom.hex")]
utiny[2112] font_data;

export uint lookup_font(ushort char_code, utiny row) {
    if (char_code < 32 as ushort || char_code > 295 as ushort) {
        return 0;
    }
    uint idx = ((char_code as uint) - FONT_BASE) * 8 + (row as uint);
    return font_data[idx] as uint;
}
